# --- PostgreSQL connection (от Render → External Database URL) ---
DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Frontend origin (за CORS). Точният URL на твоя Static Site в Render. ---
FRONTEND_URL=https://marto-blog-frontend.onrender.com

# --- Сесии ---
SESSION_SECRET=change-this-to-a-long-random-string

# --- Default admin (ползва се само при първоначалния seed) ---
ADMIN_USER=admin
ADMIN_PASS=admin123

# --- Render Persistent Disk mount path + папка за качените снимки ---
UPLOAD_DIR=/var/data/uploads

# --- Production mode (за secure cookie-та) ---
NODE_ENV=production

# --- Port (Render го задава автоматично) ---
PORT=3000
